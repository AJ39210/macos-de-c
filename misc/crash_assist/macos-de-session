#!/bin/sh
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATH="$script_dir${PATH:+:$PATH}"
export PATH
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
display_id=$(printf '%s' "${DISPLAY:-default}" | tr '/:' '__')
heartbeat_prefix="$runtime_dir/macos-de-$(id -u)-$display_id-$$"
desktop_heartbeat="$heartbeat_prefix-desktop"
wm_heartbeat="$heartbeat_prefix-wm"
desktop_pid=
wm_pid=
error_pid=
restart_requested=0

if mkdir -p /var/logs 2>/dev/null && [ -w /var/logs ]; then
    log_file=/var/logs/MACOS-DE-LOGS.txt
else
    state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}
    log_dir="$state_dir/macos-de"
    mkdir -p "$log_dir" || {
        echo "Could not create a macOS-DE log directory." >&2
        exit 1
    }
    log_file="$log_dir/MACOS-DE-LOGS.txt"
fi
export MACOS_DE_LOG_FILE=$log_file
exec >>"$log_file" 2>&1
printf '\n[%s] macOS-DE session started; logging to %s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S %z')" "$log_file"

stop_children() {
    for pid in "$desktop_pid" "$wm_pid" "$error_pid"; do
        if [ -n "$pid" ]; then
            kill -CONT "$pid" 2>/dev/null || true
            kill "$pid" 2>/dev/null || true
        fi
    done
    sleep 1
    for pid in "$desktop_pid" "$wm_pid" "$error_pid"; do
        if [ -n "$pid" ]; then
            kill -KILL "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        fi
    done
}

cleanup() {
    trap - EXIT HUP INT TERM
    stop_children
    rm -f -- "$desktop_heartbeat" "$wm_heartbeat"
}

trap cleanup EXIT
trap 'exit 143' HUP INT TERM
trap 'restart_requested=1' USR1

heartbeat_is_stale() {
    heartbeat=$1
    started_at=$2
    now=$(date +%s)
    if [ ! -e "$heartbeat" ]; then
        [ $((now - started_at)) -gt 12 ]
        return
    fi

    modified_at=$(stat -c %Y "$heartbeat" 2>/dev/null || printf '0')
    [ $((now - modified_at)) -gt 12 ]
}

while :; do
    rm -f -- "$desktop_heartbeat" "$wm_heartbeat"
    started_at=$(date +%s)
    failure_reason=

    MACOS_DE_SUPERVISOR_PID=$$ \
    MACOS_DE_HEARTBEAT="$desktop_heartbeat" \
        "$script_dir/macos-de" &
    desktop_pid=$!
    MACOS_WM_HEARTBEAT="$wm_heartbeat" \
        "$script_dir/macos-wm" &
    wm_pid=$!

    while kill -0 "$desktop_pid" 2>/dev/null &&
          kill -0 "$wm_pid" 2>/dev/null; do
        sleep 2
        if heartbeat_is_stale "$desktop_heartbeat" "$started_at" ||
           heartbeat_is_stale "$wm_heartbeat" "$started_at"; then
            failure_reason="A desktop process stopped responding to its heartbeat."
            break
        fi
    done

    if [ -z "$failure_reason" ] && ! kill -0 "$desktop_pid" 2>/dev/null; then
        wait "$desktop_pid"
        status=$?
        failure_reason="The desktop process exited unexpectedly (status $status)."
    elif [ -z "$failure_reason" ] && ! kill -0 "$wm_pid" 2>/dev/null; then
        wait "$wm_pid"
        status=$?
        failure_reason="The window manager exited unexpectedly (status $status)."
    fi

    stop_children
    desktop_pid=
    wm_pid=
    rm -f -- "$desktop_heartbeat" "$wm_heartbeat"
    if [ "$restart_requested" -eq 1 ]; then
        printf '[%s] Restart requested; restarting the desktop session.\n' \
            "$(date '+%Y-%m-%d %H:%M:%S %z')"
        restart_requested=0
        sleep 1
        continue
    fi
    if [ -n "$failure_reason" ]; then
        printf '[%s] FATAL: %s\n' \
            "$(date '+%Y-%m-%d %H:%M:%S %z')" "$failure_reason"
        MACOS_DE_LOG_FILE=$log_file MACOS_DE_SUPERVISOR_PID=$$ \
            "$script_dir/macos-de" --error "$failure_reason" &
        error_pid=$!
        while kill -0 "$error_pid" 2>/dev/null; do
            sleep 1
        done
        wait "$error_pid" 2>/dev/null || true
        error_pid=
        exit 0
    fi
    sleep 2
done
